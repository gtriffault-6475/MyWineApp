{
  "name": "myvine-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:db": "node --env-file=.env.test node_modules/.bin/vitest run lib/db",
    "migrate": "node --env-file=.env.local node_modules/.bin/node-pg-migrate up",
    "migrate:create": "node --env-file=.env.local node_modules/.bin/node-pg-migrate create",
    "import:legacy": "node --env-file=.env.local scripts/import-legacy.mjs",
    "check:setup": "node --env-file=.env.local scripts/check-setup.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.5",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.6.1",
    "fflate": "^0.8.3",
    "jose": "^6.2.4",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-istanbul": "^4.1.10",
    "better-sqlite3": "^12.4.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.22.0",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vitest": "^4.1.10",
    "ws": "^8.23.0"
  }
}
