# Copie ce fichier en .env.local et renseigne les valeurs (jamais commité).

# Mot de passe pour se connecter à l'app (utilisateur unique).
APP_PASSWORD=

# Secret de signature des cookies de session (jose). Génère-le avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# URL de connexion Neon : https://console.neon.tech
DATABASE_URL=

# Vercel Blob (store en accès privé), authentification OIDC : ces deux variables
# arrivent via `npx vercel env pull .env.local` (le jeton OIDC expire au bout de
# quelques heures : relancer la commande si besoin). Sur Vercel, rien à faire.
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=

# Reconnaissance d'étiquettes (Claude Haiku)
ANTHROPIC_API_KEY=

# Recherche de restaurants (Foursquare Places API)
FOURSQUARE_API_KEY=
