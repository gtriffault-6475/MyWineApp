# Copie ce fichier en .env.local et renseigne les valeurs (jamais commité).

# Mot de passe pour se connecter à l'app (utilisateur unique).
APP_PASSWORD=

# Secret de signature des cookies de session (jose). Génère-le avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# URL de connexion Neon : https://console.neon.tech
DATABASE_URL=

# Token Vercel Blob (store en accès privé) : onglet Storage du projet Vercel
BLOB_READ_WRITE_TOKEN=

# Reconnaissance d'étiquettes (Claude Haiku)
ANTHROPIC_API_KEY=

# Recherche de restaurants (Foursquare Places API)
FOURSQUARE_API_KEY=
